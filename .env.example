# Copy to .env and fill in the real values (never commit .env)

# PostgreSQL password (kitchentandem) - used by authserver, common-service, db-patcher
DB_PASSWORD=

# Aiven/DigitalOcean managed PostgreSQL password (db-patcher alternate profile)
AIVEN_DB_PASSWORD=

# SendGrid API key (common-service)
SENDGRID_API_KEY=
